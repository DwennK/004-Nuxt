# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=
# Turso database URL and token
TURSO_URL=
TURSO_TOKEN=
# JSON map of explicitly approved remote target IDs to environments. Keep empty for local-only work.
DB_REMOTE_TARGETS=
# Temporary local compatibility only. Never enable against staging/production.
POS_ALLOW_RUNTIME_SCHEMA_BOOTSTRAP=false
POS_ALLOW_RUNTIME_DEMO_SEED=false
# MiniMax server-side assistant configuration
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Cloudflare EMAIL binding (see docs/cloudflare-email.md); no sending API key.
MAIL_FROM=info@microwest.ch
MAIL_REPLY_TO=info@microwest.ch
# Shopify Admin API (server-side runtime config; same names in Cloudflare)
# Use client credentials OR an existing Admin token. Store secret/token as Worker secrets.
NUXT_SHOPIFY_SHOP_DOMAIN=
NUXT_SHOPIFY_CLIENT_ID=
NUXT_SHOPIFY_CLIENT_SECRET=
NUXT_SHOPIFY_ADMIN_ACCESS_TOKEN=
# MobileSentrix API credentials
MOBILESENTRIX_BASE_URL=https://www.mobilesentrix.com
MOBILESENTRIX_CONSUMER_NAME=Microwest
MOBILESENTRIX_CONSUMER_KEY=
MOBILESENTRIX_CONSUMER_SECRET=
MOBILESENTRIX_ACCESS_TOKEN=
MOBILESENTRIX_ACCESS_TOKEN_SECRET=
# MobileSentrix Cloudflare access: set the supplied ms-token value server-side.
# Keep both empty when unused; configure both in production too. See docs/mobilesentrix.md.
MOBILESENTRIX_REST_AUTH_HEADER_NAME=
MOBILESENTRIX_REST_AUTH_HEADER_VALUE=
# Auth session (nuxt-auth-utils) — must be 32+ chars (openssl rand -base64 32)
NUXT_SESSION_PASSWORD=
# Cloudflare Turnstile — use a managed widget restricted to the login hostname
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
