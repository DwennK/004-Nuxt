{
  "name": "004-Nuxt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.11.0 <25 || >=26"
  },
  "scripts": {
    "build": "pnpm run scanner:wasm && NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run security:regression && pnpm run build",
    "dev": "pnpm run scanner:wasm && nuxt dev",
    "preview": "pnpm run build && wrangler --cwd .output dev",
    "postinstall": "pnpm run scanner:wasm && nuxt prepare",
    "scanner:wasm": "node scripts/copy-scanner-wasm.mjs",
    "lint": "eslint .",
    "security:regression": "node scripts/security-regression.mjs",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:security",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "node scripts/db/introspect.mjs",
    "db:verify": "node scripts/db/verify.mjs",
    "db:status": "node scripts/db/status.mjs",
    "db:usage": "node scripts/db/usage.mjs",
    "db:migrate": "node scripts/db/migrate-safe.mjs",
    "db:backfill:document-totals": "node scripts/db/backfill-document-totals.mjs",
    "seed:test-user": "node scripts/seed-test-user.mjs",
    "deploy": "pnpm run build && wrangler --cwd .output deploy --keep-vars",
    "cf-typegen": "wrangler types server/types/cloudflare-env.d.ts --include-runtime false --env-file .env.example --env-interface PosCloudflareEnv"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/simple-icons": "^1.2.94",
    "@internationalized/date": "^3.12.4",
    "@libsql/client": "^0.17.4",
    "@nuxt/ui": "^4.10.0",
    "@tanstack/table-core": "^8.21.3",
    "@unhead/vue": "^3.4.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "barcode-detector": "^3.2.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "h3": "1.15.11",
    "markdown-it": "^15.0.1",
    "nostics": "1.2.0",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "^0.5.29",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "scule": "^1.3.0",
    "sql.js": "1.14.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-chrts": "^2.2.0",
    "vue-router": "5.3.0",
    "zod": "^4.5.4",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@adonisjs/hash": "^10.1.0",
    "@cloudflare/workers-types": "5.20261005.1",
    "@nuxt/eslint": "^1.16.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.11",
    "@vue/server-renderer": "3.5.43",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.9.1",
    "nitro-cloudflare-dev": "^0.2.2",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@11.28.4"
}
